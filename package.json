{
  "name": "sicerdas-workspace",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "desktop"
  ],
  "scripts": {
    "dev:frontend": "cd frontend && bun run dev",
    "build:frontend": "cd frontend && bun run build",
    "desktop:dev": "cd desktop && bun run dev",
    "desktop:build": "cd desktop && bun run build"
  },
  "packageManager": "bun@1.3.14"
}
